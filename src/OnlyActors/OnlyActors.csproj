<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MadbyEnhance</AssemblyName>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <RootNamespace>OnlyActors</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MediaBrowser.Model"><HintPath>../../refs/MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>../../refs/MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>../../refs/MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ConfigurationPage.html" LogicalName="OnlyActors.ConfigurationPage.html" />
    <EmbeddedResource Include="ConfigurationPage.js" LogicalName="OnlyActors.ConfigurationPage.js" />
  </ItemGroup>
</Project>
